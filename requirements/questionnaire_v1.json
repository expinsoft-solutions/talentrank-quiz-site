    "purpose": "Identify limiting behaviors",
    "questions": [
      { "id": "S1", "text": "I delay starting projects because I'm not sure I can do them perfectly.", "type": "likert", "dimension": "perfectionism", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S2", "text": "I spend so much time planning that I don't have enough time to execute.", "type": "likert", "dimension": "perfectionism", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S3", "text": "I abandon projects when I realize they won't meet my standards.", "type": "likert", "dimension": "perfectionism", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S4", "text": "When I succeed, I attribute it more to luck or timing than my abilities.", "type": "likert", "dimension": "impostor", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S5", "text": "I'm afraid people will discover I'm not as capable as they think.", "type": "likert", "dimension": "impostor", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S6", "text": "I downplay my accomplishments when others praise me.", "type": "likert", "dimension": "impostor", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S7", "text": "Before important tasks, I find reasons why I might not perform well.", "type": "likert", "dimension": "self_handicapping", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S8", "text": "I put less effort into things that matter so I have an excuse if I fail.", "type": "likert", "dimension": "self_handicapping", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S9", "text": "I take on too much so I can blame poor performance on being overcommitted.", "type": "likert", "dimension": "self_handicapping", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S10", "text": "I check with others before making decisions I could make myself.", "type": "likert", "dimension": "validation_seeking", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S11", "text": "Criticism from others affects my confidence more than it should.", "type": "likert", "dimension": "validation_seeking", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S12", "text": "I avoid stating opinions until I know what others think.", "type": "likert", "dimension": "validation_seeking", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S13", "text": "I stay in situations I've outgrown because change feels risky.", "type": "likert", "dimension": "avoidance", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S14", "text": "I avoid difficult conversations even when they're necessary.", "type": "likert", "dimension": "avoidance", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true },
      { "id": "S15", "text": "I'd rather keep the peace than advocate for what I want.", "type": "likert", "dimension": "avoidance", "reverse_scored": false, "weight": 1, "correct_answer": null, "active": true }
    ]
