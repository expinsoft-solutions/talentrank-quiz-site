# Supabase (from dashboard: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required for completing assessments (invokes score-assessment Edge Function). Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: for AI settings page to load live Claude model list from Anthropic API. Falls back to static list if unset.
# ANTHROPIC_API_KEY=your-anthropic-key-here

# S3 for question image uploads (admin). Required for uploading question images.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# Airtable export (admin Submissions tab). Get base ID from URL: airtable.com/BASE_ID/...
AIRTABLE_API_KEY=your-personal-access-token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Submissions
